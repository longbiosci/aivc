# 全文库的 JATS 源文件缓存：7.6MB 原始 XML，属于原文副本，不入库；
# 需要重建时跑 tools/build_kb.py 会重新抓取。
tools/.kb-cache/

# 投稿口的隔离区：读者投来的原文副本，只在本地存在，绝不入 main。
# 投稿走邮件：读者邮件导出成 drops/*.eml，tools/inbox.py fetch 解到 inbox/<批次>/raw/。
# 这两处都只存在于运维机器上——读者原文不进仓库、不上站。
drops/
inbox/
# tools/push_ima.py 生成的 Markdown 中间产物，进 IMA 的副本，不是站点内容。
ima_out/
# 从网盘取下来处理的原件临时落地区，归档完即清。
archive/
